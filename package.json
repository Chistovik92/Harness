{
  "name": "dsh-harness-local",
  "private": true,
  "description": "Local packaging of DeepSeek Harness Desktop installer (Windows / Linux / macOS)",
  "version": "0.2.1-rc.3",
  "scripts": {
    "build:desktop": "pnpm --dir apps/desktop run build",
    "package:win:x64": "pnpm --dir apps/desktop run package:win:x64",
    "package:win:x64:unsigned": "pnpm --dir apps/desktop run package:win:x64:unsigned",
    "package:mac:arm64": "pnpm --dir apps/desktop run package:mac:arm64",
    "package:mac:x64": "pnpm --dir apps/desktop run package:mac:x64",
    "package:linux:x64": "pnpm --dir apps/desktop run package:linux:x64",
    "check:package": "pnpm --dir apps/desktop run check:package"
  }
}
