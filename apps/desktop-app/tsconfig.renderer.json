{
  "type": "module",
  "strict": true,
  "moduleResolution": "bundler",
  "target": "ES2022",
  "lib": ["ES2022", "DOM", "DOM.Iterable"],
  "jsx": "react-jsx",
  "skipLibCheck": true,
  "esModuleInterop": true,
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "isolatedModules": true,
  "noEmit": true,
  "types": ["vite/client", "node"]
}
