{
  "appId": "com.deepseek.harness.desktop",
  "productName": "DeepSeek Harness",
  "copyright": "Copyright © 2024 DeepSeek AI",
  "directories": {
    "output": "release",
    "buildResources": "resources",
    "app": "."
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "!**/*.md",
    "!**/test/**"
  ],
  "extraMetadata": {
    "main": "dist/electron/electron/main.js",
    "description": "DeepSeek Harness Desktop — AI assistant for DeepSeek, OpenAI, Anthropic, Google, Hugging Face and local models"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "entitlements": "resources/entitlements.mac.plist",
    "gatekeeperAssess": false,
    "hardening": {
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    }
  },
  "dmg": {
    "format": "ULMO",
    "icon": "resources/icon.icns",
    "contents": [
      { "x": 130, "y": 220, "type": "link", "path": "/Applications" },
      { "x": 410, "y": 220, "type": "file" }
    ]
  },
  "win": {
    "target": ["nsis"],
    "artifactName": "${productName}-${version}-win-${arch}-${isUnsigned ? 'unsigned' : 'signed'}.${ext}",
    "icon": "resources/icon.ico",
    "publisherName": "DeepSeek AI"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DeepSeek Harness",
    "license": "resources/LICENSE",
    "uninstallDisplayName": "DeepSeek Harness"
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
    "category": "Development",
    "icon": "resources/icon.png",
    "desktop": {
      "Name": "DeepSeek Harness",
      "GenericName": "AI Assistant",
      "Comment": "Desktop AI assistant by DeepSeek",
      "MimeType": "text/plain;text/markdown;"
    }
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Chistovik92",
      "repo": "Harness",
      "vPrefixedTagName": true,
      "private": false
    }
  ]
}
