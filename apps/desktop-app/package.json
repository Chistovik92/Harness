{
  "name": "@deepseek-ai/dsh-desktop-app",
  "productName": "DeepSeek Harness",
  "version": "1.0.11",
  "description": "Desktop AI assistant — chat, plugins, local history, auto-updates (Windows / Linux / macOS)",
  "author": "DeepSeek AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"vite\" \"electron .\"",
    "build": "vite build && npm run build:electron",
    "preview": "vite preview",
    "electron": "electron .",
    "package:win": "electron-builder --win --x64",
    "package:mac": "electron-builder --mac --arm64 --x64",
    "package:linux": "electron-builder --linux --x64 --arm64",
    "package:all": "electron-builder -mwl",
    "postinstall": "electron-builder install-app-deps",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root . --dir src"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.5",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.395.0",
    "marked": "^12.0.0",
    "node-llama-cpp": "^3.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
