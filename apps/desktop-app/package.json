{
  "name": "@deepseek-ai/dsh-desktop-app",
  "productName": "DeepSeek Harness",
  "version": "1.0.0",
  "description": "Desktop AI assistant — chat, plugins, local history, auto-updates (Windows / Linux / macOS)",
  "author": "DeepSeek AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron": "electron .",
    "package:win": "electron-builder --win --x64",
    "package:mac": "electron-builder --mac --arm64 --x64",
    "package:linux": "electron-builder --linux --x64 --arm64",
    "package:all": "electron-builder -mwl",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "axios": "^1.7.2",
    "marked": "^12.0.0",
    "dompurify": "^3.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.395.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "electron": "^29.2.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.19"
  }
}
