# DeepSeek Harness Desktop — local environment (copy to .env, never commit)

# Electron / app
NODE_ENV=development

# Auto-update (GitHub Releases)
GH_TOKEN=your_github_token

# macOS signing / notarization (optional, for signed releases)
APPLE_ID=your_apple_id
APPLE_ID_PASSWORD=your_app_specific_password

# Windows code signing (optional, EV certificate)
# CSC_LINK=C:\path\to\codesign.p12
# CSC_KEY_PASSWORD=your_password
