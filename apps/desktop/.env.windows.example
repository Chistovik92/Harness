# DeepSeek Harness Desktop
Local environment variables for packaging (Windows).
Copy this file to `.env.windows` and fill in the values. Git ignores `.env.windows`.

# Application ID used by the NSIS installer and update feed
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Update channel: nightly (default) or latest
DSH_DESKTOP_UPDATE_CHANNEL=nightly

# Public code-signing certificate (CSC_LINK) and password for Windows EV signing
# DSH_DESKTOP_CSC_LINK=C:\\certs\\codesign.p12
# DSH_DESKTOP_CSC_KEY_PASSWORD=your_password

# SignTool executable path
# DSH_DESKTOP_SIGNTOOL="C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.19041.0\\x64\\signtool.exe"

# Signature container name and PIN (for hardware token)
# DSH_DESKTOP_SIGNATURE_CONTAINER=
# DSH_DESKTOP_SIGNATURE_PIN=

# Mandatory update policy service origin (HTTPS required)
# DSH_DESKTOP_UPDATE_ORIGIN=https://updates.example.com

# NPM registry (optional proxy)
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org
