# DeepSeek Harness Desktop
Local environment variables for packaging (macOS).
Copy this file to `.env.macos` and fill in the values. Git ignores `.env.macos`.

# Application ID used by the DMG/ZIP and update feed
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Update channel: nightly (default) or latest
DSH_DESKTOP_UPDATE_CHANNEL=nightly

# Developer ID Application certificate (p12) and export password
# CSC_LINK=$HOME/certs/developer_id.p12
# CSC_KEY_PASSWORD=your_password

# Apple notarization credentials (Apple ID or keychain profile strategy)
# APPLE_ID=your_apple_id
# APPLE_ID_PASSWORD=your_app_specific_password

# Team ID
# DSH_DESKTOP_TEAM_ID=ABCDE12345

# Notarization proxy (optional)
# DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

# NPM registry (optional proxy)
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org
