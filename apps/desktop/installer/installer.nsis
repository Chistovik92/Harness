; DeepSeek Harness Desktop - Windows NSIS Installer
; Unicode installer, MachineGuided (all users) or current user

!include "MUI2.nsh"
!include "x64.nsh"
!include "WinVer.nsh"
!include "LogicLib.nsh"

!define PRODUCT_NAME "DeepSeek Harness"
!define PRODUCT_PUBLISHER "DeepSeek AI"
!define PRODUCT_VERSION "0.2.1-rc.3"
!define PRODUCT_APP_ID "com.deepseek.harness"
!define INSTALLER_ICON "resources/icon-windows.ico"
!define UNINSTALLER_ICON "resources/icon-windows.ico"
!define SIDEBAR "installer/assets/sidebar.bmp"
!define UNINSTALL_REG_KEY "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\${PRODUCT_NAME}"
!define INSTALL_DIR_KEY "Software\\${PRODUCT_PUBLISHER}\\${PRODUCT_NAME}"

!installlocale 1049
!insertmacro MUI_LANGUAGE "Russian"

!define MUI_ABORTWARNING
!define MUI_ICON "${INSTALLER_ICON}"
!define MUI_UNICON "${UNINSTALLER_ICON}"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "installer/assets/LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "Russian"

Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "DeepSeek.Harness.Setup.exe"
InstallDir "$PROGRAMFILES64\\${PRODUCT_NAME}"
RequestExecutionLevel admin
ShowInstDetails show
SetCompressor /SOLID lzma
SetCompressorDictSize 32

; -------------------------------------------------------
; Sections
; -------------------------------------------------------
Section "MainSection" SEC01
  SetOutPath "$INSTDIR"
  File /r "app.asar"
  File /r "resources\*"
  File /r "resources\app.asar.unpacked\*"

  ; Register uninstaller
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Registry: install location & version
  WriteRegStr HKLM "${INSTALL_DIR_KEY}" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "${INSTALL_DIR_KEY}" "Version" "${PRODUCT_VERSION}"
  WriteRegStr HKLM "${UNINSTALL_REG_KEY}" "DisplayName" "${PRODUCT_NAME}"
  WriteRegStr HKLM "${UNINSTALL_REG_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
  WriteRegStr HKLM "${UNINSTALL_REG_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKLM "${UNINSTALL_REG_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTALL_REG_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegDWORD HKLM "${UNINSTALL_REG_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTALL_REG_KEY}" "NoRepair" 1

  ; Register dsh command in user PATH (current user)
  $0 = GetEnvPath
  ; Note: actual PATH registration handled by the launcher script at first run
  SectionEnd

; -------------------------------------------------------
; Uninstall section
; -------------------------------------------------------
Section Uninstall
  ; Remove files
  Delete "$INSTDIR\Uninstall.exe"
  RMDir /r "$INSTDIR"

  ; Remove registry
  DeleteRegKey HKLM "${UNINSTALL_REG_KEY}"
  DeleteRegKey HKLM "${INSTALL_DIR_KEY}"

  ; Remove shortcuts if any
  Delete "$SMPrograms\\${PRODUCT_NAME}\\*.*"
  RMDir "$SMPrograms\\${PRODUCT_NAME}"
SectionEnd

; -------------------------------------------------------
; Functions
; -------------------------------------------------------
Function .onInit
  !insertmacro MUI_RESERVEFILE_INSTALLOPTION_RTL
FunctionEnd

Function .onSuccess
  ; Launch app after install
  Exec '"$INSTDIR\${PRODUCT_NAME}.exe"'
FunctionEnd
